# ==============================================================================
# LibreChat Local Offline Configuration (Template Example)
# Debian Dev Suite (100% Localhost Isolated, Zero Telemetry)
# Copy this file to .env or run ./setup-librechat.sh to generate automatically
# ==============================================================================

# Network & Host Binding (Strict Localhost)
HOST=127.0.0.1
PORT=3080

# Database Connection (Unified 127.0.0.1 for both Docker host networking & Native)
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# Cryptographic Authentication Secrets (Auto-generated with 'openssl rand -hex 32')
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# AES-256-CBC Credential Encryption Keys (Auto-generated)
CREDS_KEY=replace_with_openssl_rand_hex_32
CREDS_IV=replace_with_openssl_rand_hex_16

# Strict Privacy & Zero-Telemetry Settings
TELEMETRY=false
DISABLE_TELEMETRY=true
CHECK_BALANCE=false

# User Registration & Access Controls
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_PASSWORD_RESET=false

# Custom Configuration File
CONFIG_PATH=/app/librechat.yaml

# Optional: Native In-App Search (MeiliSearch)
# Enable via ./tools/toggle-meilisearch.sh --enable
# SEARCH=true
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_HTTP_ADDR=127.0.0.1:7700
# MEILI_MASTER_KEY=replace_with_openssl_rand_hex_16
# MEILI_NO_ANALYTICS=true
# MEILI_SYNC_THRESHOLD=0

